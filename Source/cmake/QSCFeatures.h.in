#ifndef QSC_CMAKE_FEATURES_H
#define QSC_CMAKE_FEATURES_H
/** \file QSCFeatures.h
 * \brief Generated CMake build capability descriptor.
 * \note Compiled capability does not establish device availability or authorization.
 */
/** \def QSC_CMAKE_PROFILE
 * \brief Application profile selected at CMake configuration.
 */
#define QSC_CMAKE_PROFILE "@QSC_PROFILE@"
/** \def QSC_CMAKE_ALGORITHMS
 * \brief Comma-separated algorithms selected at build time.
 */
#define QSC_CMAKE_ALGORITHMS "@QSC_MANIFEST_ALGORITHMS@"
/** \def QSC_CMAKE_HARDWARE_ENABLED
 * \brief True when hardware-provider support was requested.
 */
#define QSC_CMAKE_HARDWARE_ENABLED @QSC_FEATURE_HARDWARE@
/** \def QSC_CMAKE_PROVIDER_NAMES
 * \brief Comma-separated provider names configured into this library.
 */
#define QSC_CMAKE_PROVIDER_NAMES "@QSC_MANIFEST_HARDWARE@"
/** \def QSC_CMAKE_HAS_SHA2
 * \brief True if SHA-2 source is compiled.
 */
#define QSC_CMAKE_HAS_SHA2 @QSC_FEATURE_SHA2@
/** \def QSC_CMAKE_HAS_SHA3
 * \brief True if SHA-3 source is compiled.
 */
#define QSC_CMAKE_HAS_SHA3 @QSC_FEATURE_SHA3@
/** \def QSC_CMAKE_HAS_X25519
 * \brief True if X25519 source is compiled.
 */
#define QSC_CMAKE_HAS_X25519 @QSC_FEATURE_X25519@
/** \def QSC_CMAKE_HAS_KYBER768
 * \brief True if ML-KEM-768 source is compiled.
 */
#define QSC_CMAKE_HAS_KYBER768 @QSC_FEATURE_KYBER768@
/** \def QSC_CMAKE_HAS_KYBER1024
 * \brief True if ML-KEM-1024 source is compiled.
 */
#define QSC_CMAKE_HAS_KYBER1024 @QSC_FEATURE_KYBER1024@
/** \def QSC_CMAKE_HAS_MLDSA65
 * \brief True if ML-DSA-65 source is compiled.
 */
#define QSC_CMAKE_HAS_MLDSA65 @QSC_FEATURE_MLDSA65@
/** \def QSC_CMAKE_HAS_MLDSA87
 * \brief True if ML-DSA-87 source is compiled.
 */
#define QSC_CMAKE_HAS_MLDSA87 @QSC_FEATURE_MLDSA87@
#endif
