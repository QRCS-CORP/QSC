{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/qsc/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "QSC_BUILD_PROFILE_TESTS": "ON"
      }
    },
    {
      "name": "full",
      "inherits": "base",
      "cacheVariables": {
        "QSC_PROFILE": "FULL"
      }
    },
    {
      "name": "full-shared",
      "inherits": "base",
      "cacheVariables": {
        "QSC_PROFILE": "FULL",
        "QSC_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "boot-verify",
      "inherits": "base",
      "cacheVariables": {
        "QSC_PROFILE": "BOOT_VERIFY"
      }
    },
    {
      "name": "device-identity",
      "inherits": "base",
      "cacheVariables": {
        "QSC_PROFILE": "DEVICE_IDENTITY"
      }
    },
    {
      "name": "classical",
      "inherits": "base",
      "cacheVariables": {
        "QSC_PROFILE": "CRYPTO_CLASSICAL"
      }
    },
    {
      "name": "pqc3",
      "inherits": "base",
      "cacheVariables": {
        "QSC_PROFILE": "CRYPTO_PQC3"
      }
    },
    {
      "name": "pqc5",
      "inherits": "base",
      "cacheVariables": {
        "QSC_PROFILE": "CRYPTO_PQC5"
      }
    },
