    {
      "name": "vehicle-ecu",
      "inherits": "base",
      "cacheVariables": {
        "QSC_PROFILE": "VEHICLE_ECU"
      }
    },
    {
      "name": "hsm-pkcs11",
      "inherits": "base",
      "cacheVariables": {
        "QSC_PROFILE": "CLOUD_HSM",
        "QSC_ENABLE_HARDWARE": "ON",
        "QSC_HARDWARE_PROVIDERS": "PKCS11"
      }
    }
